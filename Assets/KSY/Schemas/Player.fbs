namespace InputData.Player;

table Movement {
  movement_state:ubyte;
  move_x:byte;
  dash_x:byte;
  dash_y:byte;
}

table ItemAction{
	action_state:ubyte;
	action_item_id:ushort;
	shot_dir_x:byte;
	shot_dir_y:byte;
	charge_gauge:ubyte;
}

table PlayerPos{
	x:byte;
	y:byte;
}

union PlayerMessageType{
	item_action:ItemAction,
	movement:Movement,
	pos:PlayerPos
}

table PlayerMessage{
	data:PlayerMessageType;
}
file_identifier "PLYR";
root_type PlayerMessage;
