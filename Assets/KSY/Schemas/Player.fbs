namespace InputData.Player;

table Movement {
  movement_state:ubyte;
  move_x:byte;
  dash_x:byte;
  dash_y:byte;
}

table ItemAction{
	action_state:ubyte;
	action_item_id:ushort;
	shot_dir_x:byte;
	shot_dir_y:byte;
	charge_gauge:ubyte;
}

table PlayerPos{
	x:float;
	y:float;
}

table itemPos{
	id:ushort;
	x:float;
	y:float;
}

table itemDestroy{
	id:ushort;
}

union PlayerMessageType{
	item_action:ItemAction,
	movement:Movement,
	player_pos:PlayerPos,
	item_pos:itemPos,
	itme_des:itemDestroy
}

table PlayerMessage{
	data:PlayerMessageType;
}
file_identifier "PLYR";
root_type PlayerMessage;
